{
    "name": "vanoverberghe-react-modal-component",
    "version": "1.0.2",
    "description": "Un composant Modal React réutilisable",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "esbuild src/index.js --bundle --format=cjs --outfile=dist/index.cjs --jsx=automatic --loader:.js=jsx --external:react --external:react-dom --external:prop-types && esbuild src/index.js --bundle --format=esm --outfile=dist/index.mjs --jsx=automatic --loader:.js=jsx --external:react --external:react-dom --external:prop-types",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "react",
        "modal",
        "dialog",
        "component"
    ],
    "author": "Vanoverberghe Stéphanie",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/stephanievanoverberghe/ocr-p14-component-modal.git"
    },
    "dependencies": {
        "prop-types": "^15.8.1"
    },
    "peerDependencies": {
        "react": ">=17.0.0",
        "react-dom": ">=17.0.0"
    },
    "devDependencies": {
        "esbuild": "^0.24.0"
    }
}
